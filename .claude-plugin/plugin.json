{
  "name": "plures",
  "version": "1.0.0",
  "description": "Human in the loop for AI agents: ask ID verified people to check a decision before your agent acts. Adds the Plures skill and the plures-mcp server (ask_humans).",
  "author": { "name": "Plures Labs", "email": "hello@plures.si", "url": "https://plures.si" },
  "homepage": "https://plures.si/docs",
  "repository": "https://github.com/plureslabs/plures",
  "license": "MIT",
  "keywords": ["human-in-the-loop", "hitl", "human review", "approvals", "agents", "mcp", "verification"],
  "skills": "./skills/",
  "mcpServers": {
    "plures": {
      "command": "npx",
      "args": ["-y", "plures-mcp"],
      "env": { "PLURES_API_KEY": "${PLURES_API_KEY}" }
    }
  }
}
