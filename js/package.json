{
  "name": "plures",
  "version": "1.11.0",
  "description": "Human judgment as an API for AI agents. Send a decision to ID verified people and get their consensus back.",
  "keywords": [
    "human-in-the-loop",
    "hitl",
    "ai-agents",
    "human-review",
    "human-approval",
    "agents",
    "llm",
    "verification",
    "plures"
  ],
  "homepage": "https://plures.si/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plureslabs/plures.git",
    "directory": "js"
  },
  "bugs": "https://github.com/plureslabs/plures/issues",
  "license": "MIT",
  "author": "Plures Labs LLC <hello@plures.si>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  },
  "bin": {
    "plures": "dist/cli.js"
  }
}
